{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameVerse",
  "version": "0.1.3",
  "identifier": "com.gameverse.desktop",
  "build": {
    "beforeDevCommand": "npm run build:web && npm run dev:web",
    "beforeBuildCommand": "npm run build:web",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GameVerse",
        "width": 1440,
        "height": 920,
        "minWidth": 360,
        "minHeight": 500,
        "center": true,
        "resizable": true,
        "backgroundColor": "#111313"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
